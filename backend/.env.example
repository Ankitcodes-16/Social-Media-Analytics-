# Trend Sphere backend environment (copy to .env)

# PostgreSQL connection. In docker-compose this matches the `db` service below;
# for a local Postgres install, point it at your own instance instead.
DATABASE_URL=postgresql+psycopg2://trendsphere:trendsphere@db:5432/trendsphere

# Comma-separated origins allowed to call this API from the browser.
# Include the Next.js dev server origin.
CORS_ORIGINS=http://localhost:3000

# Re-run the deterministic scenario generator and overwrite all data on startup.
# Safe to leave true for this phase: the "ingested" data is simulated, so there
# is nothing real to lose. Set to false once you seed once and want the alert
# status workflow (see below) to persist across restarts.
RESEED_ON_STARTUP=true
