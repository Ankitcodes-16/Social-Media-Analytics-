# ─────────────────────────────────────────────────────────────
# Trend Sphere — frontend environment (copy to .env.local)
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# NEVER put API keys, tokens or database credentials here —
# those belong to the backend (backend/.env, added in Phase 2).
# ─────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend (used only by services switched to API mode).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Which services read from the FastAPI backend instead of the simulated dataset.
# Comma-separated subset of: overview,topics,posts,sentiment,trends,alerts,network
# Use "all" to switch everything. Leave empty for Phase 1 (all simulated).
# Recommended integration order: posts,topics,sentiment,trends,alerts,network
NEXT_PUBLIC_API_SERVICES=

# Artificial latency for simulated services, in ms (makes loading states visible).
NEXT_PUBLIC_MOCK_LATENCY_MS=220
